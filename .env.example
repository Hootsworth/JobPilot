# ==============================================================================
# JobPilot Environment Configuration (.env.example)
# Copy to .env (API / crawler scripts) and apps/web/.env.local (Next.js client).
# NEVER commit real keys or .env files.
# ==============================================================================

# --- LLM Provider Layer (switching requires zero code changes) ---
# Supported values: openai | gemini | meta
LLM_PROVIDER=gemini
# Optional default model ID. Leave blank to choose dynamically via live listModels()
# in the Settings UI, or set an explicit model ID supported by your provider.
LLM_MODEL=

OPENAI_API_KEY=
GEMINI_API_KEY=
META_API_KEY=
# Meta Llama API OpenAI-compatible endpoint (NOT native /v1). Overridable.
META_BASE_URL=https://api.llama.com/compat/v1/

# --- Server BYOK Encryption ---
# Required in production/BYOK mode: 64 hex chars (32 bytes), e.g. `openssl rand -hex 32`
APP_ENCRYPTION_KEY=

# --- Supabase (Publishable & Secret API Keys — replaces legacy anon/service_role) ---
SUPABASE_URL=
# Publishable key (sb_publishable_...) from Project Settings -> API Keys
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) from Project Settings -> API Keys (SERVER ONLY, never expose to client)
SUPABASE_SECRET_KEY=

# --- Phase 2 Job Ingestion Connectors (Official APIs Only) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
# Optional RapidAPI free-tier connector (off unless key is set)
JSEARCH_RAPIDAPI_KEY=
JSEARCH_MAX_PAGES_PER_RUN=1

# --- API Server (Fastify) ---
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- Next.js Web App (apps/web/.env.local) ---
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) — safe for browser with Postgres RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000
